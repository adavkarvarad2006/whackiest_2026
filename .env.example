# ArthaLens Backend Environment Configuration
# Copy this file to .env and populate secrets before running.

# PostgreSQL + pgvector connection string
DATABASE_URL=postgresql+psycopg://arthalens:arthalens_dev_password@localhost:5432/arthalens

# Groq API Configuration (required for Ask ArthaLens LLM responses)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding Model (Sentence Transformers, 384-dim)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Authentication & Security
JWT_SECRET_KEY=change_this_to_a_long_random_secret_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# File Upload & Storage Limits
UPLOAD_STORAGE_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=20

# Chunking & Retrieval Tuning
CHUNK_SIZE_TOKENS=900
CHUNK_OVERLAP_TOKENS=125
RETRIEVAL_TOP_K=6
SIMILARITY_THRESHOLD=0.22

# Optional Reference Date (YYYY-MM-DD) for FD maturity / time-window checks.
# Leave empty to use system today(), or set to 2026-05-15 when testing DEMO_001.
ARTHALENS_REFERENCE_DATE=2026-05-15

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
